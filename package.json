{
  "name": "dot-stash",
  "version": "0.0.1",
  "description": "Standalone Stencil web-components UI library (light DOM ds-* components) with a SCSS theming toolkit.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/dot-stash/dot-stash.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jezoock/dot-stash.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "stencil build --docs",
    "build:css": "gulp buildCSS",
    "build:all": "npm run clean && npm run build:css && npm run build",
    "clean": "node -e \"for (const dir of ['dist', 'www', '.stencil', 'loader']) require('fs').rmSync(dir, { recursive: true, force: true })\"",
    "start": "npm run build:css && stencil build --dev --watch --serve",
    "dev": "npm run build:css && stencil build --dev",
    "serve:theme": "gulp",
    "test": "stencil test --spec",
    "test.watch": "stencil test --spec --watchAll",
    "test:e2e": "stencil test --e2e",
    "generate": "stencil generate",
    "lint": "eslint components",
    "lint:fix": "eslint components --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,scss,json,html,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,scss,json,html,yml,yaml,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stencil/core": "^4.45.2",
    "@stencil/sass": "^3.3.3",
    "@types/jest": "^27.5.2",
    "browser-sync": "^2.29.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-imagemin": "^8.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-webp": "^4.0.1",
    "jest": "^27.5.1",
    "jest-cli": "^27.5.1",
    "prettier": "^3.9.10",
    "puppeteer": "^19.5.2",
    "sass": "^1.107.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1"
  },
  "license": "MIT"
}
