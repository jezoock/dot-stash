{
  "name": "dot-stash",
  "version": "0.1.0",
  "description": "A standalone UI library: light-DOM web components (ds-* custom elements, Stencil) and a SCSS theming toolkit, with no runtime dependency.",
  "keywords": [
    "web-components",
    "custom-elements",
    "stencil",
    "light-dom",
    "design-system",
    "ui",
    "scss",
    "sass",
    "theming",
    "design-tokens",
    "accessibility",
    "forms"
  ],
  "homepage": "https://github.com/jezoock/dot-stash#readme",
  "bugs": {
    "url": "https://github.com/jezoock/dot-stash/issues"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/dot-stash/dot-stash.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jezoock/dot-stash.git"
  },
  "files": [
    "dist/",
    "loader/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "stencil build --docs",
    "build:css": "node scripts/build-css.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:all": "npm run clean && npm run build:css && npm run build",
    "check:package": "node scripts/check-package.mjs",
    "clean": "node -e \"for (const dir of ['dist', 'www', '.stencil', 'loader']) require('fs').rmSync(dir, { recursive: true, force: true })\"",
    "start": "node scripts/dev.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "test": "vitest run --project unit --project styles",
    "test:watch": "vitest --project unit --project styles",
    "test:browser": "vitest run --project browser",
    "generate": "stencil generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"scss/**/*.scss\" \"components/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,mts,scss,json,html,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,mts,scss,json,html,yml,yaml,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stencil/core": "^4.45.2",
    "@stencil/sass": "^3.3.3",
    "@stencil/vitest": "1.16.1",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
